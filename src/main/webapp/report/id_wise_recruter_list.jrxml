     r_signup.`phone_no` AS r_signup_phone_no,
     r_signup.`address` AS r_signup_address,
     r_signup.`photo` AS r_signup_photo
FROM
     `r_signup` r_signup
where

r_id = $P{id};]]>
	</queryString>

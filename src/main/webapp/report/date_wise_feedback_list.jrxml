	<queryString>
		<![CDATA[SELECT
     e_feedback.`e_id` AS e_feedback_e_id,
     e_feedback.`name` AS e_feedback_name,
     e_feedback.`email` AS e_feedback_email,
     e_feedback.`rating` AS e_feedback_rating,
     e_feedback.`feedback` AS e_feedback_feedback,
     e_feedback.`date` AS e_feedback_date
FROM
     `e_feedback` e_feedback

where

date = $P{date};]]>
	</queryString>

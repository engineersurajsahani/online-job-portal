	<parameter name="id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     r_add_job.`job_id` AS r_add_job_job_id,
     r_add_job.`category` AS r_add_job_category,
     r_add_job.`jobtitle` AS r_add_job_jobtitle,
     r_add_job.`companyname` AS r_add_job_companyname,
     r_add_job.`JobType` AS r_add_job_JobType,
     r_add_job.`position` AS r_add_job_position,
     r_add_job.`Experience` AS r_add_job_Experience,
     r_add_job.`Qualification` AS r_add_job_Qualification,
     r_add_job.`location` AS r_add_job_location,
     r_add_job.`salary` AS r_add_job_salary,
     r_add_job.`job_discription` AS r_add_job_job_discription,
     r_add_job.`companylogo` AS r_add_job_companylogo,
     r_add_job.`requirement` AS r_add_job_requirement,
     r_add_job.`job_upload_date` AS r_add_job_job_upload_date,
     r_add_job.`r_id` AS r_add_job_r_id
FROM
     `r_add_job` r_add_job
where

job_id = $P{id};]]>
	</queryString>

	</parameter>
	<queryString>
		<![CDATA[SELECT
     e_apply_job.`a_id` AS e_apply_job_a_id,
     e_apply_job.`job_id` AS e_apply_job_job_id,
     e_apply_job.`job_title` AS e_apply_job_job_title,
     e_apply_job.`job_type` AS e_apply_job_job_type,
     e_apply_job.`company` AS e_apply_job_company,
     e_apply_job.`location` AS e_apply_job_location,
     e_apply_job.`salary` AS e_apply_job_salary,
     e_apply_job.`image` AS e_apply_job_image,
     e_apply_job.`applay_date` AS e_apply_job_applay_date,
     e_apply_job.`user_id` AS e_apply_job_user_id,
     e_apply_job.`name` AS e_apply_job_name,
     e_apply_job.`mobilenumber` AS e_apply_job_mobilenumber,
     e_apply_job.`email` AS e_apply_job_email,
     e_apply_job.`resume` AS e_apply_job_resume,
     e_apply_job.`status` AS e_apply_job_status,
     e_apply_job.`r_id` AS e_apply_job_r_id,
     e_apply_job.`interview_date` AS e_apply_job_interview_date,
     e_apply_job.`interview_time` AS e_apply_job_interview_time,
     e_apply_job.`interview_location` AS e_apply_job_interview_location
FROM
     `e_apply_job` e_apply_job
where
applay_date =$P{date};]]>
	</queryString>

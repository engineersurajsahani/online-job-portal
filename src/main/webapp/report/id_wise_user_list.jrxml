	<queryString>
		<![CDATA[SELECT
     e_signup.`id` AS e_signup_id,
     e_signup.`fullname` AS e_signup_fullname,
     e_signup.`username` AS e_signup_username,
     e_signup.`email` AS e_signup_email,
     e_signup.`gender` AS e_signup_gender,
     e_signup.`phone_no` AS e_signup_phone_no,
     e_signup.`password` AS e_signup_password,
     e_signup.`photo` AS e_signup_photo
FROM
     `e_signup` e_signup
where

id = $P{id};]]>
	</queryString>
